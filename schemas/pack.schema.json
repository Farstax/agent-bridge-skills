{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Farstax/agent-bridge-skills/schemas/pack.schema.json",
  "title": "Farstax Agent Bridge Skill Pack",
  "description": "Draft v1alpha1 contract for a Skill Pack manifest. A Skill Pack is a manifest over ordinary Agent Bridge Skills, not a runtime. Tracks Farstax/agent-bridge#703; compatibility.status must stay \"pending\" until #703 ships a canonical schema, at which point this schema should be reconciled with it rather than maintained as a second contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "maintainers",
    "license",
    "categories",
    "capabilities",
    "compatibility",
    "skills",
    "dependencies",
    "secrets",
    "effects"
  ],
  "properties": {
    "schemaVersion": {
      "const": "farstax.agent-bridge.skill-pack/v1alpha1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$",
      "description": "Stable, unique, lowercase kebab-case pack id."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$",
      "description": "Semantic version of the pack content."
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "license": {
      "type": "string",
      "description": "SPDX identifier for Farstax-authored pack content in this pack. Upstream-derived Skills record their own licence in their skill.yaml."
    },
    "categories": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "minItems": 1
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentBridge", "status"],
      "properties": {
        "agentBridge": {
          "description": "Supported Agent Bridge version range once Farstax/agent-bridge#703 ships the pack mechanism. Must stay null while status is \"pending\".",
          "type": ["null", "string"]
        },
        "status": {
          "type": "string",
          "enum": ["pending", "supported"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "pending" } } },
          "then": { "properties": { "agentBridge": { "const": null } } }
        },
        {
          "if": { "properties": { "status": { "const": "supported" } } },
          "then": { "properties": { "agentBridge": { "type": "string" } } }
        }
      ]
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalServices", "local"],
      "properties": {
        "externalServices": {
          "type": "array",
          "items": { "type": "string" }
        },
        "local": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required", "purpose"],
        "properties": {
          "name": { "type": "string" },
          "required": { "type": "boolean" },
          "purpose": { "type": "string" }
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalRead", "externalWrite", "financialSpend"],
      "properties": {
        "externalRead": { "type": "boolean" },
        "externalWrite": { "type": "boolean" },
        "financialSpend": { "type": "boolean" }
      }
    },
    "tests": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
