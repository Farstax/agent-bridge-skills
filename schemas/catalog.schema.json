{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Farstax/agent-bridge-skills/schemas/catalog.schema.json",
  "title": "Farstax Agent Bridge Skill Pack catalogue",
  "description": "Draft v1alpha1 index of curated packs published by this repository.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "description", "packs"],
  "properties": {
    "schemaVersion": {
      "const": "farstax.agent-bridge.skill-pack-catalog/v1alpha1"
    },
    "description": { "type": "string", "minLength": 1 },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
